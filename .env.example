# Production settings - copy to .env on the server (see docs/deployment.md)

# Generate a strong random password: openssl rand -hex 24
DB_PASSWORD=change-me
# Generate a strong random key: openssl rand -hex 32
JWT_SECRET=change-me
# The salon's time zone (statistics and the nightly backup schedule use it)
SALON_TZ=Europe/Berlin

# --- Publish mode ---
# Default: PRIVATE. The app only listens on 127.0.0.1:3001 and Tailscale provides
# access from outside. This holds as long as the four lines below stay commented out.
#
# PUBLIC MODE (no Tailscale needed, needs a domain - see docs/deployment.md):
# uncomment all four lines, then: docker compose up -d
# COMPOSE_FILE=docker-compose.yml:docker-compose.public.yml
# PUBLIC_DOMAIN=yoursalon.duckdns.org
# BASIC_AUTH_USER=salon
# REQUIRED if Tailscale is installed on the server too: tailscale serve holds 443 on
# its own IP, so Caddy cannot bind 0.0.0.0. The server's public IP:
#   ip -4 addr show scope global | grep -oP '(?<=inet )[\d.]+' | grep -v '^100\.'
# PUBLIC_BIND_IP=
# Hash of the shared gate password:  docker run --rm caddy caddy hash-password --plaintext 'PASSWORD'
# CAREFUL: the hash contains $ signs, put it in SINGLE QUOTES - otherwise docker compose
# reads them as variables and mangles it. Example:  BASIC_AUTH_HASH='$2a$14$abc...'
# BASIC_AUTH_HASH=
# Value of the cookie left on a device that passed the gate (valid for 2 years).
# Must be a random secret, SEPARATE from the password:  openssl rand -hex 32
# Changing it signs every device out - the only way to lock out a lost phone;
# changing the password is NOT enough (a device with the cookie never sees the gate).
# GATE_COOKIE=

# --- Email (Brevo SMTP) - alerts and nightly backups ---
# Open a Brevo account (brevo.com) -> SMTP & API -> create an SMTP key.
# Left empty, the system runs without mail (backups stay on the server only).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address (must be verified in Brevo) and recipient address
MAIL_FROM=
ALERT_TO=
